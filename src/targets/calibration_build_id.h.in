#pragma once

// Generated by CMake `configure_file` from calibration_build_id.h.in -- DO NOT EDIT the generated
// copy in the build directory. Content is byte-stable across repeated identical configures: no
// timestamp, no UUID, no generator expression that varies run-to-run. `CMAKE_CUDA_ARCHITECTURES`
// is sorted before being joined so list-order alone never changes the fingerprint.
//
// Exact input list feeding NINFER_BUILD_FINGERPRINT_INPUT (documented here as the single source
// of truth for what build_id depends on):
//   CMAKE_CXX_COMPILER_ID
//   CMAKE_CXX_COMPILER_VERSION
//   CMAKE_CUDA_COMPILER_ID
//   CMAKE_CUDA_COMPILER_VERSION
//   CMAKE_CUDA_ARCHITECTURES (sorted)
//   CMAKE_BUILD_TYPE
//   CMAKE_CXX_FLAGS
//   active-config CMAKE_CXX_FLAGS_<CONFIG>
//   CMAKE_CUDA_FLAGS
//   active-config CMAKE_CUDA_FLAGS_<CONFIG>
//   NINFER_SM8X_COMPAT (0 or 1; kernel-affecting per root CMakeLists.txt)
//
// CMAKE_CUDA_HOST_COMPILER is deliberately NOT included: this build system does not set it
// explicitly, so including it would add a noisy non-semantic path rather than a meaningful input.
//
// build_id itself is NOT computed here -- this header only emits the canonicalized input string.
// calibration_collect.cpp hashes it with the existing sha256_hex() at first use, once, so the
// host test can also feed synthetic input strings through the same hashing path without
// reconfiguring the build (see calibration_collect_test.cpp).
//
// kNinferCudaArchList / kNinferBuildType are the same two configure-time values (sorted arch list,
// build type) reused verbatim to populate BuildIdentity::cuda_arch_list / build_type -- required
// non-empty by missing_requirements() -- so a live collect_build_identity() call can actually
// qualify, not just produce a build_id. kNinferCompileFlagsAudit is a ";"-joined deterministic
// audit representation of the effective CXX/CUDA flags (empty only when genuinely no extra flags
// are set) that populates BuildIdentity::compile_flags.

inline constexpr char kNinferBuildFingerprintInput[] =
    "cxx_compiler_id=@CMAKE_CXX_COMPILER_ID@;"
    "cxx_compiler_version=@CMAKE_CXX_COMPILER_VERSION@;"
    "cuda_compiler_id=@CMAKE_CUDA_COMPILER_ID@;"
    "cuda_compiler_version=@CMAKE_CUDA_COMPILER_VERSION@;"
    "cuda_architectures=@NINFER_SORTED_CUDA_ARCHITECTURES@;"
    "build_type=@CMAKE_BUILD_TYPE@;"
    "cxx_flags=@CMAKE_CXX_FLAGS@;"
    "cxx_flags_config=@NINFER_ACTIVE_CXX_FLAGS_CONFIG@;"
    "cuda_flags=@CMAKE_CUDA_FLAGS@;"
    "cuda_flags_config=@NINFER_ACTIVE_CUDA_FLAGS_CONFIG@;"
    "ninfer_sm8x_compat=@NINFER_SM8X_COMPAT_VALUE@";

inline constexpr char kNinferCudaArchList[] = "@NINFER_SORTED_CUDA_ARCHITECTURES@";
inline constexpr char kNinferBuildType[] = "@CMAKE_BUILD_TYPE@";
inline constexpr char kNinferCompileFlagsAudit[] = "@NINFER_COMPILE_FLAGS_AUDIT@";
